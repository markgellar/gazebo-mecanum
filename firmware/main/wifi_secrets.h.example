// Copy to wifi_secrets.h (gitignored) and fill in. Without wifi_secrets.h the robot runs its own
// access point "MecanumRobot" and expects the agent at 192.168.4.2, as before.
#pragma once

#define HOME_WIFI_SSID "your-network-name"
#define HOME_WIFI_PASSWORD "your-password"
// The laptop running the micro-ROS agent, on the home network. Reserve this address in the router's
// DHCP settings so it doesn't change. (In WSL with mirrored networking it's the Windows WiFi address.)
#define HOME_AGENT_IP "10.0.0.154"
